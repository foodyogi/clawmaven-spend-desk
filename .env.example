# Copy to .env and fill in locally. Never commit .env.
# On Render, set these as environment variables instead.

# PayPal Payouts — SANDBOX credentials only (base URL: https://api-m.sandbox.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=

# LLM
ANTHROPIC_API_KEY=
# Pin the engine so it does not auto-select the Builder.io gateway
AGENT_ENGINE=

# Spend Desk policy file (defaults to ./policy.json)
POLICY_PATH=

# Custom health check message
PING_MESSAGE=

# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
BETTER_AUTH_SECRET=
AUTH_DISABLED=
