# Copy to .env and fill in locally. Never commit .env.
# On Render, set these as environment variables instead.

# PayPal Payouts — SANDBOX credentials only (base URL: https://api-m.sandbox.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=

# LLM
ANTHROPIC_API_KEY=
# Pin the engine so it does not auto-select the Builder.io gateway
AGENT_ENGINE=

# Postgres (Neon pooled connection string). Unset locally = PGlite in data/.
DATABASE_URL=

# Spend Desk policy file (defaults to ./policy.json)
POLICY_PATH=

# Custom health check message
PING_MESSAGE=

# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
BETTER_AUTH_SECRET=
# Production: exact https origins of the deployed site, comma-separated (see DEPLOY.md)
BETTER_AUTH_TRUSTED_ORIGINS=
# Local dev only. Never set in production.
AUTH_DISABLED=

# Signs durable background agent runs on Netlify (see DEPLOY.md)
A2A_SECRET=

# NEAR payout rail (branch `near`, testnet only). Names only; see contracts/spend-desk-treasury/README.md.
# The app refuses the NEAR rail unless NEAR_NETWORK is testnet.
NEAR_NETWORK=
NEAR_RPC_URL=
# Treasury contract account
NEAR_CONTRACT_ID=
# Account that owns the agent's function-call key
NEAR_AGENT_ACCOUNT_ID=
# Function-call access key ONLY (scoped to NEAR_CONTRACT_ID, payout method, finite allowance). Never a full-access key.
NEAR_AGENT_PRIVATE_KEY=
# Owner account, for docs and local admin scripts. The owner's full-access key is never stored here;
# owner actions are signed with NEAR CLI from its local key store.
NEAR_OWNER_ACCOUNT_ID=
# Optional: payee for `pnpm near:smoke` (defaults to m22spend-payee1.testnet)
NEAR_SMOKE_PAYEE=
